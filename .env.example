# Aurora / RDS
DB_HOST=your-aurora-writer-endpoint
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=ecommerce
DB_PORT=3306

# S3
S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-south-2

# SQS
SQS_QUEUE_URL=https://sqs.ap-south-2.amazonaws.com/YOUR_ACCOUNT_ID/your-queue-name

# Flask
SECRET_KEY=replace-with-a-strong-random-secret

# Cognito values are read by config.py from SSM Parameter Store:
# /ecommerce/COGNITO_USER_POOL_ID
# /ecommerce/COGNITO_CLIENT_ID
# /ecommerce/COGNITO_CLIENT_SECRET
